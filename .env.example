# Copy to .env. Never commit real credentials.
# The launcher generates a private random local token when this value is empty.
COOLING_AUTH_MODE=local_token
COOLING_API_TOKEN=
COOLING_API_URL=http://127.0.0.1:8000
COOLING_STORAGE=sqlite
COOLING_SQLITE_PATH=.local/cooling-advisor.sqlite3
COOLING_CATALOG_DIR=.local/catalog

# Optional genuine parent/child Gemini function calling; enabled per case.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional Supabase auth + RLS case storage. Configure BOTH modes together.
# COOLING_AUTH_MODE=supabase
# COOLING_STORAGE=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Never put a service-role key in the dashboard or frontend.
